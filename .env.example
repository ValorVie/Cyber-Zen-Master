# LLM API金鑰配置
# 複製此文件為.env並填入您的API金鑰

# 默認提供商設置（可選：openai, deepseek, xai）
DEFAULT_LLM_PROVIDER=xai

# OpenAI API配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORGANIZATION=your_organization_id_here
OPENAI_MODEL=gpt-4-turbo  # 或其他可用模型

# DeepSeek API配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat  # 或其他可用模型

# X.AI API配置
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-3-beta  # X.AI的默認模型

# Anthropic API配置
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# API基礎URL配置（可選，僅在需要自定義API端點時設置）
# OPENAI_BASE_URL=https://api.openai.com/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# XAI_BASE_URL=https://api.x.ai/v1
